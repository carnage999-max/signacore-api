SECRET_KEY=replace-with-real-secret
DEBUG=False
ALLOWED_HOSTS=api.mysignacore.com,sign.mysignacore.com,127.0.0.1,localhost
TIME_ZONE=UTC

# Production reverse-proxy hardening. Keep these enabled when serving through HTTPS.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_TRUSTED_ORIGINS=https://mysignacore.com,https://www.mysignacore.com,https://sign.mysignacore.com

DB_NAME=signacore_db
DB_USER=signacore_user
DB_PASSWORD=replace-with-real-password
DB_HOST=postgres
DB_PORT=5432
# Set to require when DB_HOST is a hosted PostgreSQL provider such as Neon.
DB_SSLMODE=

REDIS_URL=redis://redis:6379/3
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/3

# Generate once, store in the deployment secret manager, and back it up. Rotation requires a data migration.
FERNET_KEY=replace-with-real-fernet-key
SIGNACORE_TEMP_ROOT=/run/signacore
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=replace-with-resend-api-key
DEFAULT_FROM_EMAIL=SignaCore - by Se7en <signacore@mysignacore.com>

SIGNACORE_STORAGE_ROOT=/mnt/data/media/signa-core
SIGNACORE_HOST_STORAGE_ROOT=/mnt/data/media/signa-core
MEDIA_ROOT=/mnt/data/media/signa-core
MEDIA_URL=/media/
# Maximum PDF upload size accepted by Django. Keep Nginx slightly higher for multipart overhead.
SIGNACORE_MAX_DOCUMENT_UPLOAD_BYTES=26214400
STATIC_ROOT=/srv/apps/signacore-api/staticfiles
SIGNACORE_HOST_STATIC_ROOT=/srv/apps/signacore-api/staticfiles

CORS_ALLOWED_ORIGINS=https://mysignacore.com,https://www.mysignacore.com
SIGNACORE_SHARED_SECRET=replace-with-shared-secret
SIGNACORE_SERVICE_USERNAME=signacore-service
SIGNACORE_APP_URL=https://mysignacore.com
SIGNACORE_SIGNER_PORTAL_URL=https://sign.mysignacore.com
SIGNING_LINK_EXPIRY_DAYS=7
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# Stripe subscription billing. Use test-mode values until production launch.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_API_VERSION=2026-02-25.clover

# Google and Apple account sign-in. Redirect URIs are configured by the Next.js app.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=com.example.signacore.web
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"

SIGNACORE_API_PORT=8010
SIGNACORE_API_CONTAINER_NAME=signacore-api
SIGNACORE_WORKER_CONTAINER_NAME=signacore-worker
SIGNACORE_BEAT_CONTAINER_NAME=signacore-beat
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
CELERY_CONCURRENCY=2
